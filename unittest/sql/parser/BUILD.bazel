load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "ai_column_parser_cases",
    srcs = ["test_ai_column_parser.cpp"],
    alwayslink = True,
    deps = ["//bazel/third_party:gtest", "//src/sql:file_sql_test_headers"],
)

cc_test(
    name = "test_ai_column_parser",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [":ai_column_parser_cases", "//src/observer:liboceanbase"],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_library(
    name = "file_sql_parser_cases",
    srcs = ["test_file_sql_parser.cpp"],
    alwayslink = True,
    deps = ["//bazel/third_party:gtest", "//src/sql:file_sql_test_headers"],
)

cc_test(
    name = "test_file_sql_parser",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [":file_sql_parser_cases", "//src/observer:liboceanbase"],
    target_compatible_with = ["@platforms//os:linux"],
)
